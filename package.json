{
  "name": "just-one-more",
  "version": "1.0.0",
  "description": "A real-time push-your-luck card game for friends.",
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "build": "tsc -b && vite build && vite build --ssr src/server/index.ts",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && npm run lint && vitest run",
    "test:integration": "vitest run --project integration",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:client": "vitest run --project client",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 28",
    "test:e2e": "npm run build && playwright test",
    "test:load": "k6 run tests/load/tables.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluckspielsucht-selbsthilfegruppe/just-one-more.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/gluckspielsucht-selbsthilfegruppe/just-one-more/issues"
  },
  "homepage": "https://github.com/gluckspielsucht-selbsthilfegruppe/just-one-more#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.61.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
